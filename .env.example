# Feedants Full-Stack Deployment Configuration

# ── Backend Configuration ──
PORT=5000
NODE_ENV=production
# Local Docker Compose MongoDB connection:
MONGODB_URI=mongodb://mongo:27017/feedants
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feedants?retryWrites=true&w=majority

# JWT secret key (replace with a 32+ character random string in production)
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# ── Frontend Configuration ──
FRONTEND_PORT=3000
# URL where your backend API is accessible by browsers / mobile apps:
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
