# Base URL for Feedants Backend API
# For local development with Expo Go on a physical device, use your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:5000/api/v1
# For local web or simulator:
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# For production deployment:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
